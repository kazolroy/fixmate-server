# MongoDB (same database the client's BetterAuth uses)
MONGODB_URI=your_mongodb_uri
DB_NAME=fixmate

# Shared secret used to verify JWTs issued by the Next.js app (/api/token).
# MUST be identical to JWT_SECRET in the client's .env.local
JWT_SECRET=your_jwt_secret

# Stripe (test mode)
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Primary client URL (used for Stripe success/cancel URLs) and CORS
CLIENT_URL=http://localhost:3000
# Optional: extra allowed origins, comma separated (e.g. preview domains)
EXTRA_ORIGINS=

PORT=5000
